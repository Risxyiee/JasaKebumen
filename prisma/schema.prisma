generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters", "queryCompiler"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Category {
  id        String   @id @default(cuid())
  name      String   @unique
  slug      String   @unique
  icon      String   @default("zap")
  createdAt DateTime @default(now())

  providers Provider[]
}

model District {
  id        String   @id @default(cuid())
  name      String   @unique
  slug      String   @unique
  createdAt DateTime @default(now())

  providers Provider[]
}

model Provider {
  id             String   @id @default(cuid())
  name           String
  description    String   @default("")
  whatsappNumber String
  imageUrl       String?
  images         String[] @default([]) // foto usaha (maks 3, data URL) — dilayani via /api/providers/[id]/images/[n]
  status         String   @default("pending") // pending | published | rejected
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  districtId String
  district   District @relation(fields: [districtId], references: [id], onDelete: Cascade)

  reviews Review[]
}

model Review {
  id         String   @id @default(cuid())
  providerId String
  provider   Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  name       String
  rating     Int // 1..5
  comment    String   @default("")
  status     String   @default("pending") // pending | published | rejected
  createdAt  DateTime @default(now())

  @@index([providerId, status])
}

model CsMessage {
  id        String   @id @default(cuid())
  sessionId String // sesi chat widget per pengunjung
  name      String   @default("") // nama panggilan (opsional)
  contact   String   @default("") // nomor WA penganjur, jika ditinggalkan
  text      String
  handled   Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([sessionId])
  @@index([handled, createdAt])
}
