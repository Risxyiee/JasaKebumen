# ============================================
# Cloudflare Workers + Supabase PostgreSQL
# ============================================
# Set these as SECRETS in Cloudflare Workers dashboard (NOT in this file)
#
# DATABASE_URL = postgresql://postgres.<ref>:<PASSWORD>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
#   (salin dari Dashboard Supabase -> Connect -> "Session pooler";
#    password ber karakter khusus harus di-URL-encode, mis. # -> %23)
# ADMIN_USERNAME = admin
# ADMIN_PASSWORD = your_password
#
# ------------------------------------------------------------------
# Dev lokal: buat file .env (gitignored) berisi URL postgres ASLI.
# JANGAN memakai file:... — provider skema ini postgresql; URL selain
# postgres:// membuat semua query gagal, dan nilai seperti itu bisa
# disuntik ke environment shell sehingga menimpa .env (@next/env tidak
# menimpa variabel shell yang sudah ada).
#   DATABASE_URL=postgresql://<user>:<password>@<host>:<port>/<db>?sslmode=require
# ------------------------------------------------------------------

# =============
# Mapbox (peta 3D hero) — OPSIONAL
# =============
# Tanpa token: hero menampilkan fallback glass yang tetap berfungsi.
# Ambil access token gratis di https://account.mapbox.com (50k load map/bln).
#NEXT_PUBLIC_MAPBOX_TOKEN=pk.eyJ1...
#
# Dua jalur pasang di PRODUKSI (pilih salah satu, keduanya didukung kode):
# 1) RUNTIME — set sebagai Secret di dashboard Cloudflare
#    (Workers & Pages -> jasakebumen -> Settings -> Variables and Secrets,
#    type Text, nama NEXT_PUBLIC_MAPBOX_TOKEN). Server component membacanya
#    saat request dan meneruskan token ke klien -> peta langsung hidup
#    TANPA rebuild (perubahan secret otomatis me-restart worker).
# 2) BUILD-TIME — set sebagai Build Variable di pipeline deploy, lalu
#    redeploy (NEXT_PUBLIC_* di-inline ke bundle saat next build).
