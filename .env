# ============================================
# Aiven PostgreSQL — isi dengan connection string Anda
# ============================================
# Format:
#   DATABASE_URL = postgresql://<user>:<password>@<host>:<port>/<dbname>?sslmode=require
#   DIRECT_URL   = postgresql://<user>:<password>@<host>:<port>/<dbname>?sslmode=require
#
# Contoh Aiven:
#   DATABASE_URL = postgresql://avnadmin:password@pg-xxxxx.aivencloud.com:27378/defaultdb?sslmode=require
#   DIRECT_URL   = postgresql://avnadmin:password@pg-xxxxx.aivencloud.com:27378/defaultdb?sslmode=require
# ============================================

DATABASE_URL=postgresql://avnadmin:CHANGE_ME@pg-CHANGE_ME.aivencloud.com:27378/defaultdb?sslmode=require
DIRECT_URL=postgresql://avnadmin:CHANGE_ME@pg-CHANGE_ME.aivencloud.com:27378/defaultdb?sslmode=require

# Admin Basic Auth — ganti dengan kredensial asli Anda
ADMIN_USERNAME=admin
ADMIN_PASSWORD=kebumen2025
